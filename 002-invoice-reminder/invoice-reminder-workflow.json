    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0); \n\nconst outputItems = [];\nconst escalations = [];\nconst rejected = []; \n\nitems.forEach(item => {\n  const d = item.json;\n  const status = (d['Status'] || '').toString().trim().toLowerCase();\n  const rawDueDate = d['Due Date'];\n  \n  let dueDate = new Date(rawDueDate);\n  let isValidDate = !isNaN(dueDate.getTime());\n  \n  if (isValidDate) dueDate.setHours(0, 0, 0, 0);\n  \n  if (isValidDate && dueDate <= today && status === 'unpaid') {\n    const daysOverdue = Math.floor((today - dueDate) / (1000 * 60 * 60 * 24));\n    const contact = (d['Client Contact'] || '').toString().trim();\n    \n    // CHECK: Does the contact field have an '@' symbol?\n    \n    const isEmail = contact.includes('@');\n    \n    // Assign type based on whether it's an email or a phone/username\n    const reminderType = isEmail ? 'reminder_email' : 'reminder_telegram';\n\n    const messageBody = `Hi ${d['Client Name']},<br><br>\nThis is a reminder that invoice ${d['Invoice Number']} for KES ${d['Amount (KES)']} was due on ${rawDueDate} and remains unpaid.<br><br>\nAs an eTIMS-compliant business, this invoice has already been transmitted to the KRA portal. If you need us to resend the official eTIMS-compliant copy for your processing, just reply to this email and we'll send it right over.<br><br>\nCould you please let us know when we can expect payment? If it's already sorted, please ignore this reminder.<br><br>\nThanks for your business,<br>\nThe Finance Team`;\n\n    outputItems.push({\n      json: {\n        type: reminderType,\n        to: contact,\n        clientName: d['Client Name'],\n        invoiceNumber: d['Invoice Number'],\n        amount: d['Amount (KES)'],\n        dueDate: rawDueDate,\n        daysOverdue,\n        subject: `Reminder: Invoice ${d['Invoice Number']} is overdue`,\n        body: messageBody\n      }\n    });\n\n    if (daysOverdue >= 14) {\n      escalations.push(`• ${d['Client Name']} — Invoice ${d['Invoice Number']}, KES ${d['Amount (KES)']}, ${daysOverdue} days overdue`);\n    }\n  } else {\n    let reason = !isValidDate ? 'Invalid Date Format' : (dueDate > today ? 'Date is in the future' : `Status is '${status}', not 'unpaid'`);\n    rejected.push({ client: d['Client Name'], status: status, rawDueDate: rawDueDate, reason: reason });\n  }\n});\n\nconst summaryMessage = outputItems.length === 0\n  ? `No overdue invoices today. Rejected ${rejected.length} item(s): ${JSON.stringify(rejected)}`\n  : `${outputItems.length} overdue invoice(s) today, ${escalations.length} at 14+ days.`;\n\noutputItems.push({ json: { type: 'summary', message: summaryMessage } });\n\nif (escalations.length > 0) {\n  outputItems.push({ json: { type: 'escalation', message: `Invoices overdue 14+ days (${escalations.length}):\\n\\n${escalations.join('\\n')}` } });\n}\n\nreturn outputItems;"
      },
