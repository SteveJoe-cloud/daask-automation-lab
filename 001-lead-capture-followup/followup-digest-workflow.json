        "jsCode": "const today = new Date().toISOString().split('T')[0]; // e.g. \"2026-08-31\"\nconst excludedStages = ['Client', 'Retainer', 'Lost'];\n\nconst due = items.filter(item => {\n  const d = item.json;\n  const followUp = (d['Next Follow-up Date'] || '').toString().slice(0, 10); // keep to YYYY-MM-DD\n  const stage = d['Stage'] || '';\n  return followUp && followUp <= today && !excludedStages.includes(stage);\n});\n\nlet message;\nif (due.length === 0) {\n  message = \"No follow-ups due today.\";\n} else {\n  const lines = due.map(item => {\n    const d = item.json;\n    return `• ${d['Name']} (${d['Sector'] || 'N/A'}) — Stage: ${d['Stage']}, due ${d['Next Follow-up Date']}`;\n  });\n  message = `Follow-ups due today (${due.length}):\\n\\n${lines.join('\\n')}`;\n}\n\nreturn [{ json: { message } }];"
      },
