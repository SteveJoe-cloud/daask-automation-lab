    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  const buffer = await this.helpers.getBinaryDataBuffer(item.index, 'data');\n  items.push({\n    json: {\n      ...item.json,\n      base64Audio: buffer.toString('base64')\n    }\n  });\n}\nreturn items;"
      },
